<?xml version="1.0" encoding="utf-8"?>
<!-- Kleines Widget (1 Zeile hoch oder 1 Spalte breit): Symbol, Titel,
     eine Zeile Inhalt, rechts Häkchen oder Schnellaktionen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_padding"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:tint="@color/widget_primary" />

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_check"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_check"
        android:padding="10dp"
        android:src="@drawable/ic_widget_check_off"
        android:tint="@color/widget_primary"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_action_2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_action_background"
        android:padding="8dp"
        android:tint="@color/widget_on_primary_container"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_action_1"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_action_background"
        android:padding="8dp"
        android:tint="@color/widget_on_primary_container"
        android:visibility="gone" />
</LinearLayout>
