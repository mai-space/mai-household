<?xml version="1.0" encoding="utf-8"?>
<!-- Haushaltsdaten nie in Google-Backups oder Gerätetransfer (Android 12+;
     ältere Versionen: allowBackup=false): Die Datenbank ist mit einem
     Keystore-Schlüssel verschlüsselt, der das Gerät nicht verlässt. Neues
     Gerät: Haushalt per QR-Code im WLAN teilen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
